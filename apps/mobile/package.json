{
  "name": "@pali/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "EXPO_NO_TELEMETRY=1 expo start",
    "ios": "EXPO_NO_TELEMETRY=1 expo run:ios",
    "android": "EXPO_NO_TELEMETRY=1 expo run:android",
    "web": "EXPO_NO_TELEMETRY=1 expo start --web",
    "build:web": "EXPO_NO_TELEMETRY=1 expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./scripts/register-shared-test-dependencies.mjs --test tests/*.test.ts",
    "test:ui": "playwright test",
    "test:watch-ui": "node scripts/build-native-watch-ui.cjs && playwright test --config playwright.watch.config.ts",
    "test:activity-ui": "node scripts/build-native-activity-ui.cjs && playwright test --config playwright.activity.config.ts",
    "test:faucet-ui": "playwright test --config playwright.faucet.config.ts",
    "test:recovery-ui": "node scripts/build-native-recovery-ui.cjs && playwright test --config playwright.recovery.config.ts",
    "lint": "eslint . --max-warnings 0",
    "postinstall": "node ../../scripts/apply-keyring-ledger.cjs && node ../../scripts/apply-walletconnect-terminal.cjs"
  },
