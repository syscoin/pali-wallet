{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "target": "ES2022",
    "paths": {
      "@noble/curves/bn254": ["./node_modules/@noble/curves/bn254"],
      "@noble/curves/abstract/edwards": [
        "./node_modules/@noble/curves/abstract/edwards.d.ts"
      ],
      "@sidhujag/sysweb3-keyring": [
        "./node_modules/@sidhujag/sysweb3-keyring/types/index.d.ts"
      ],
      "@sidhujag/sysweb3-keyring/cjs/*.js": [
        "./node_modules/@sidhujag/sysweb3-keyring/types/*.d.ts"
      ],
      "@sidhujag/sysweb3-keyring/cjs/*": [
        "./node_modules/@sidhujag/sysweb3-keyring/types/*.d.ts"
      ],
      "@sidhujag/sysweb3-network": [
        "./node_modules/@sidhujag/sysweb3-network/types/index.d.ts"
      ],
      "@sidhujag/sysweb3-network/cjs/evm.js": [
        "./node_modules/@sidhujag/sysweb3-network/types/evm.d.ts"
      ],
      "@sidhujag/sysweb3-network/cjs/coin-utils.js": [
        "./node_modules/@sidhujag/sysweb3-network/types/coin-utils.d.ts"
      ],
      "@sidhujag/sysweb3-network/cjs/coins.js": [
        "./node_modules/@sidhujag/sysweb3-network/types/coins.d.ts"
      ],
      "@sidhujag/sysweb3-network/cjs/networks.js": [
        "./node_modules/@sidhujag/sysweb3-network/types/networks.d.ts"
      ],
      "@sidhujag/sysweb3-network/cjs/ownedUtxoRpc.js": [
        "./node_modules/@sidhujag/sysweb3-network/types/ownedUtxoRpc.d.ts"
      ],
      "axios": ["./node_modules/axios/index.d.ts"],
      "fast-safe-stringify": ["./node_modules/fast-safe-stringify/index.d.ts"],
      "bitcoinjs-lib": ["./node_modules/bitcoinjs-lib"],
      "ethers": ["./node_modules/ethers"],
      "ethers/abi": ["./node_modules/ethers/lib.esm/abi/index.d.ts"],
      "ethers/address": ["./node_modules/ethers/lib.esm/address/index.d.ts"],
      "ethers/contract": ["./node_modules/ethers/lib.esm/contract/index.d.ts"],
      "ethers/crypto": ["./node_modules/ethers/lib.esm/crypto/index.d.ts"],
      "ethers/hash": ["./node_modules/ethers/lib.esm/hash/index.d.ts"],
      "ethers/providers": ["./node_modules/ethers/lib.esm/providers/index.d.ts"],
      "ethers/transaction": [
        "./node_modules/ethers/lib.esm/transaction/index.d.ts"
      ],
      "ethers/utils": ["./node_modules/ethers/lib.esm/utils/index.d.ts"],
      "utils/ethersV6Compat": ["../../source/utils/ethersV6Compat.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
